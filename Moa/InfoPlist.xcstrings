    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets people on the same Wi-Fi send photos straight to this iPhone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Wi-Fi에 있는 사람이 보낸 사진을 이 iPhone으로 바로 받기 위해 필요해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows people on the same Wi-Fi to send photos directly to this iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于直接接收同一 Wi-Fi 下的人发送到这台 iPhone 的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於直接接收同一個 Wi-Fi 下的人傳送到這部 iPhone 的照片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じWi-Fiにいる人が送った写真を、このiPhoneで直接受け取るために必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы фото от людей из той же сети Wi-Fi сразу приходили на этот iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que las personas en la misma red Wi-Fi envíen fotos directamente a este iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht es Personen im selben WLAN, Fotos direkt an dieses iPhone zu senden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet aux personnes sur le même Wi-Fi d’envoyer des photos directement à cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per ricevere direttamente su questo iPhone le foto inviate da chi è sullo stesso Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para receber direto neste iPhone as fotos enviadas por quem está no mesmo Wi-Fi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อรับรูปที่คนใน Wi-Fi เดียวกันส่งมาที่ iPhone เครื่องนี้โดยตรง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần để nhận thẳng trên iPhone này những ảnh do người dùng chung Wi-Fi gửi đến."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní lidem ve stejné Wi-Fi posílat fotky přímo na tento iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader folk på samme Wi-Fi sende billeder direkte til denne iPhone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει σε όσους βρίσκονται στο ίδιο Wi-Fi να στέλνουν φωτογραφίες απευθείας σε αυτό το iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa samassa Wi-Fi-verkossa olevien lähettää kuvia suoraan tähän iPhoneen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar orang di Wi-Fi yang sama bisa mengirim foto langsung ke iPhone ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar folk på samme Wi-Fi sende bilder rett til denne iPhonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat mensen op hetzelfde wifi-netwerk foto's rechtstreeks naar deze iPhone sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala odbierać na tym iPhonie zdjęcia wysyłane przez osoby z tej samej sieci Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör att personer på samma Wi-Fi kan skicka bilder direkt till den här iPhonen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı Wi-Fi ağındaki kişilerin gönderdiği fotoğrafları doğrudan bu iPhone'a almak için gerekli."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the photos guests send to your Photos app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트가 보낸 사진을 사진 앱에 넣기 위해 필요해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds photos sent by guests to your Photos app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于将参与者发送的照片添加到“照片”App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將參與者傳送的照片加入「照片」App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストが送った写真を写真アプリに追加するために必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы добавлять в «Фото» снимки, которые отправляют гости."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a la app Fotos las fotos que envían los invitados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt die Fotos, die Gäste senden, deiner Fotos-App hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute à l’app Photos les photos envoyées par les invités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per aggiungere all'app Foto le foto inviate dagli ospiti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para adicionar ao app Fotos as fotos enviadas pelos convidados."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อเพิ่มรูปที่แขกส่งมาลงในแอปรูปภาพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần để thêm ảnh khách gửi đến vào ứng dụng Ảnh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá fotky, které hosté pošlou, do aplikace Fotky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer de billeder, gæsterne sender, til din Fotos-app."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει στις Φωτογραφίες τις φωτογραφίες που στέλνουν οι καλεσμένοι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää vieraiden lähettämät kuvat Kuvat-appiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memasukkan foto kiriman tamu ke app Foto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger bildene gjestene sender inn i Bilder-appen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt de foto's die gasten sturen toe aan je Foto's-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje zdjęcia wysłane przez gości do aplikacji Zdjęcia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till bilderna som gäster skickar i Bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misafirlerin gönderdiği fotoğrafları Fotoğraflar uygulamanıza eklemek için gerekli."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates an album for each event and places the photos guests send at the time they were taken."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트 앨범을 만들고, 게스트가 보낸 사진을 촬영 시각 그대로 사진 앱에 정리하기 위해 필요해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates an album for each event and files photos sent by guests at the time they were taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于创建活动相册，并将参与者发送的照片按拍摄时间整理到“照片”App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於建立活動相簿，並將參與者傳送的照片依拍攝時間整理到「照片」App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントのアルバムを作成し、ゲストが送った写真を撮影時刻のまま写真アプリに整理するために必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы создавать альбом для каждого события и раскладывать снимки гостей в «Фото» по времени съёмки."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un álbum para cada evento y coloca en Fotos las fotos de los invitados con la hora a la que se hicieron."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt für jedes Event ein Album und sortiert die Fotos der Gäste zum Aufnahmezeitpunkt in Fotos ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un album pour chaque événement et place dans Photos les photos des invités à leur heure de prise de vue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per creare un album per ogni evento e sistemare in Foto le foto inviate dagli ospiti con la data in cui sono state scattate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para criar um álbum para cada evento e organizar no app Fotos as fotos enviadas pelos convidados na data em que foram feitas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อสร้างอัลบั้มของแต่ละอีเวนต์ และจัดรูปที่แขกส่งมาในแอปรูปภาพตามเวลาที่ถ่ายจริง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần để tạo album cho từng sự kiện và sắp xếp ảnh khách gửi đến trong ứng dụng Ảnh đúng thời điểm chụp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří album pro každou událost a zařadí fotky od hostů podle času pořízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opretter et album til hver begivenhed og placerer de billeder, gæsterne sender, på det tidspunkt, de blev taget."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργεί ένα άλμπουμ για κάθε εκδήλωση και βάζει τις φωτογραφίες των καλεσμένων στη στιγμή που τραβήχτηκαν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo albumin jokaiselle tapahtumalle ja sijoittaa vieraiden lähettämät kuvat ottohetkensä kohdalle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membuat album acara dan menata foto kiriman tamu di app Foto sesuai waktu pengambilannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppretter et album for hvert arrangement og legger bildene gjestene sender på tidspunktet de ble tatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een album per evenement en zet de foto's die gasten sturen op het moment waarop ze zijn gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy album dla każdego wydarzenia i układa zdjęcia od gości według godziny ich wykonania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar ett album för varje event och placerar bilderna som gäster skickar på den tid de togs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her etkinlik için bir albüm oluşturmak ve misafirlerin gönderdiği fotoğrafları çekildikleri saate göre yerleştirmek için gerekli."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
