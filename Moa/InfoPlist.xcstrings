    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to scan someone’s event QR code so you can send them photos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람의 이벤트 QR을 찍어 사진을 보내기 위해 필요해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to scan someone’s event QR code so you can send them photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于扫描他人的活动二维码，以便向其发送照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於掃描他人的活動 QR 碼，以便傳送照片給對方。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のイベントQRコードを読み取って写真を送るために使います。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы сканировать QR-код мероприятия другого человека и отправлять ему фото."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para escanear el código QR del evento de otra persona y enviarle fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um den Event-QR-Code einer anderen Person zu scannen und ihr Fotos zu senden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à scanner le QR code d’événement de quelqu’un pour lui envoyer des photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a inquadrare il codice QR dell’evento di un’altra persona per inviarle foto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada para escanear o QR code do evento de outra pessoa e enviar fotos para ela."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้สแกนคิวอาร์โค้ดงานของผู้อื่นเพื่อส่งรูปให้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để quét mã QR sự kiện của người khác và gửi ảnh cho họ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží ke skenování QR kódu akce jiné osoby, abyste jí mohli poslat fotky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at scanne en andens begivenheds-QR-kode, så du kan sende billeder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για τη σάρωση του κωδικού QR εκδήλωσης κάποιου, ώστε να του στείλετε φωτογραφίες."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään toisen tapahtuman QR-koodin skannaamiseen kuvien lähettämistä varten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai untuk memindai kode QR acara orang lain agar bisa mengirim foto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å skanne noens arrangements-QR-kode så du kan sende bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt om iemands evenement-QR-code te scannen en diegene foto’s te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do skanowania kodu QR wydarzenia innej osoby, aby wysłać jej zdjęcia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att skanna någons event-QR-kod så att du kan skicka bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka birinin etkinlik QR kodunu okutup ona fotoğraf göndermek için kullanılır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to send and receive photos directly with people nearby."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처 사람과 사진을 바로 주고받기 위해 필요해요."
