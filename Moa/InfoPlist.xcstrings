          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at sende og modtage billeder direkte med folk i nærheden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για απευθείας αποστολή και λήψη φωτογραφιών με άτομα κοντά σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään kuvien lähettämiseen ja vastaanottamiseen suoraan lähellä olevien kanssa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
