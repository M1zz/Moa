        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do wysyłania i odbierania zdjęć bezpośrednio z osobami w pobliżu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
