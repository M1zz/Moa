    "한 명씩 추가할 필요가 없어요. 멤버 누구나 다른 사람을 초대할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to add people one by one. Any member can invite others."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to add people one by one. Any member can invite others."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需逐个添加。任何成员都能邀请别人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用一個一個加入。任何成員都能邀請別人。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1人ずつ追加する必要はありません。メンバーなら誰でもほかの人を招待できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никого не нужно добавлять по одному. Приглашать может любой участник."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hace falta añadir a nadie uno por uno. Cualquier miembro puede invitar a otros."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand muss einzeln hinzugefügt werden. Jedes Mitglied kann weitere einladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutile d’ajouter les gens un par un. Chaque membre peut inviter d’autres personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno da aggiungere uno per uno. Ogni membro può invitare altri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisa adicionar ninguém um a um. Qualquer membro pode convidar outras pessoas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องเพิ่มคนทีละคน สมาชิกทุกคนเชิญคนอื่นต่อได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần thêm từng người. Thành viên nào cũng có thể mời người khác."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikoho nemusíte přidávat po jednom. Pozvat další může kterýkoli člen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen skal tilføjes en ad gangen. Alle medlemmer kan invitere andre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται να προσθέτετε έναν έναν. Κάθε μέλος μπορεί να προσκαλέσει άλλους."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketään ei tarvitse lisätä yksitellen. Kuka tahansa jäsen voi kutsua muita."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak perlu menambahkan satu per satu. Setiap anggota bisa mengundang orang lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen må legges til én etter én. Alle medlemmer kan invitere andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hoeft één voor één te worden toegevoegd. Elk lid kan anderen uitnodigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikogo nie trzeba dodawać pojedynczo. Każdy członek może zapraszać innych."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen behöver läggas till en i taget. Alla medlemmar kan bjuda in fler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimseyi tek tek eklemeniz gerekmez. Her üye başkalarını davet edebilir."
          }
        }
      }
    },
    "호스트 iPhone에 연결하지 못했어요. 같은 Wi-Fi인지, 로컬 네트워크 권한을 허용했는지 확인해 주세요.%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the host's iPhone. Check that you're on the same Wi-Fi and that Local Network access is allowed.%@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the host's iPhone. Check that you're on the same Wi-Fi and that Local Network access is switched on.%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到接收方的 iPhone。请确认已连接同一 Wi-Fi，并已允许访问本地网络。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到接收方的 iPhone。請確認已連接同一個 Wi-Fi，並已允許存取區域網路。%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストのiPhoneに接続できませんでした。同じWi-Fiに接続しているか、ローカルネットワークへのアクセスを許可しているか確認してください。%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к iPhone организатора. Проверьте, что вы в той же сети Wi-Fi и что доступ к локальной сети разрешён.%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el iPhone del anfitrión. Comprueba que estás en la misma red Wi-Fi y que se ha permitido el acceso a la red local.%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zum iPhone des Gastgebers fehlgeschlagen. Prüfe, ob du im selben WLAN bist und der Zugriff auf das lokale Netzwerk erlaubt ist.%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre l’iPhone de l’hôte. Vérifiez que vous êtes sur le même Wi-Fi et que l’accès au réseau local est autorisé.%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile collegarsi all'iPhone dell'host. Controlla di essere sullo stesso Wi-Fi e di aver consentito l'accesso alla rete locale.%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao iPhone do anfitrião. Verifique se vocês estão no mesmo Wi-Fi e se o acesso à Rede Local está permitido.%@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับ iPhone ของเจ้าของอีเวนต์ไม่ได้ ตรวจสอบว่าใช้ Wi-Fi เดียวกัน และอนุญาตการเข้าถึงเครือข่ายภายในแล้ว%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được với iPhone của chủ sự kiện. Hãy kiểm tra xem hai máy có cùng Wi-Fi không và đã cho phép truy cập mạng cục bộ chưa.%@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit s iPhonem hostitele. Zkontrolujte, že jste ve stejné Wi-Fi a že máte povolený přístup k místní síti.%@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få forbindelse til værtens iPhone. Tjek, at I er på samme Wi-Fi, og at adgang til lokalt netværk er slået til.%@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με το iPhone του διοργανωτή. Ελέγξτε ότι είστε στο ίδιο Wi-Fi και ότι επιτρέπεται η πρόσβαση στο τοπικό δίκτυο.%@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyttä isännän iPhoneen ei saatu. Tarkista, että olet samassa Wi-Fi-verkossa ja että paikallisen verkon käyttö on sallittu.%@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa terhubung ke iPhone host. Pastikan di Wi-Fi yang sama dan akses Jaringan Lokal sudah diizinkan.%@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikk ikke kontakt med vertens iPhone. Sjekk at dere er på samme Wi-Fi og at tilgang til lokalt nettverk er tillatt.%@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon geen verbinding maken met de iPhone van de host. Controleer of je op hetzelfde wifi-netwerk zit en of toegang tot het lokale netwerk is toegestaan.%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z iPhonem organizatora. Sprawdź, czy jesteście w tej samej sieci Wi-Fi i czy zezwolono na dostęp do sieci lokalnej.%@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå värdens iPhone. Kontrollera att ni är på samma Wi-Fi och att åtkomst till lokalt nätverk är tillåten.%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alıcının iPhone'una bağlanılamadı. Aynı Wi-Fi ağında olduğunuzdan ve Yerel Ağ erişimine izin verildiğinden emin olun.%@"
          }
        }
      }
    },
