    "고른 사진과 동영상이 원본 그대로, 찍은 시각 그대로 앨범 멤버 모두의 사진 앱에 들어가요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photos and videos you pick go to every album member’s Photos app in full quality, at the time they were taken."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photos and videos you pick go to every album member’s Photos app in full quality, at the time they were taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选的照片和视频会以原图、按拍摄时间进入相簿所有成员的“照片”App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你選的照片和影片會以原檔、按拍攝時間進入相簿所有成員的「照片」App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ写真とビデオは、オリジナルのまま撮影日時どおりに、アルバムのメンバー全員の写真アプリに入ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные фото и видео попадут в «Фото» всех участников альбома в оригинальном качестве и с исходной датой съемки."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos y vídeos que elijas llegan a la app Fotos de todos los miembros del álbum en calidad original y con su hora de captura."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Fotos und Videos landen in Originalqualität und mit Aufnahmezeit in der Fotos‑App aller Albummitglieder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos choisies arrivent en qualité originale, à leur heure de prise de vue, dans l’app Photos de tous les membres de l’album."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto e i video che scegli arrivano in qualità originale, con l’ora dello scatto, nell’app Foto di tutti i membri dell’album."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e os vídeos escolhidos chegam ao app Fotos de todos os membros do álbum em qualidade original, no horário em que foram feitos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปและวิดีโอที่เลือกจะเข้าแอปรูปภาพของสมาชิกทุกคนในอัลบั้มแบบต้นฉบับ ตรงตามเวลาที่ถ่าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh và video bạn chọn sẽ vào ứng dụng Ảnh của mọi thành viên album với chất lượng gốc, đúng thời điểm chụp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané fotky a videa dorazí v původní kvalitě a s časem pořízení do Fotek všech členů alba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De billeder og videoer, du vælger, kommer i original kvalitet og med optagelsestidspunktet i alle albummedlemmers Fotos-app."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες και τα βίντεο που επιλέγετε φτάνουν σε αρχική ποιότητα, με την ώρα λήψης, στις Φωτογραφίες όλων των μελών του άλμπουμ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemasi kuvat ja videot tulevat alkuperäislaatuisina ja kuvausajan mukaan kaikkien albumin jäsenten Kuvat-appiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dan video yang kamu pilih masuk ke app Foto semua anggota album dalam kualitas asli, sesuai waktu pengambilannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildene og videoene du velger, kommer i originalkvalitet og med opptakstidspunkt i Bilder-appen til alle albummedlemmene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto’s en video’s die je kiest, komen in originele kwaliteit en met hun opnametijd in de Foto’s-app van alle albumleden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane zdjęcia i filmy trafią w oryginalnej jakości, z czasem wykonania, do aplikacji Zdjęcia wszystkich członków albumu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilderna och videorna du väljer hamnar i originalkvalitet, med tidpunkten de togs, i alla albummedlemmars Bilder-app."
