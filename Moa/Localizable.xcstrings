    "행사에서 QR을 보여주기만 하면 돼요. 사진을 보내는 사람은 앱을 설치하지 않고, 카메라로 QR을 찍어서 바로 보낼 수 있어요." : {
      "comment" : "Onboarding page 1 body",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just show the QR code at your event. Guests send photos right away by scanning it with the camera, with no app to install."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just show the QR code at your event. Guests scan it with their camera and send photos straight away, with no app to install."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在活动现场亮出二维码就行。发送照片的人无需安装 App，用相机扫码即可直接发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在活動現場出示 QR Code 就行。傳送照片的人不必安裝 App，用相機掃描即可直接傳送。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントでQRを見せるだけ。写真を送る人はアプリをインストールせず、カメラでQRを読み取ってすぐに送れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто покажите QR-код на мероприятии. Гости отсканируют его камерой и сразу отправят фото, без установки приложения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tienes que mostrar el QR en tu evento. Los invitados lo escanean con la cámara y envían sus fotos al momento, sin instalar ninguna app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig bei deinem Event einfach den QR-Code. Gäste scannen ihn mit der Kamera und senden ihre Fotos sofort, ganz ohne App."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suffit de montrer le QR code pendant votre événement. Les invités le scannent avec l’appareil photo et envoient leurs photos aussitôt, sans installer d’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti basta mostrare il QR all'evento. Chi invia le foto non deve installare nessuna app: inquadra il QR con la fotocamera e invia subito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta mostrar o QR no evento. Quem envia as fotos não precisa instalar nada: escaneia o QR com a câmera e já pode mandar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่แสดง QR ในงาน ผู้ส่งรูปไม่ต้องติดตั้งแอป เพียงสแกน QR ด้วยกล้องก็ส่งได้ทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chỉ cần cho mọi người xem mã QR tại sự kiện. Người gửi không cần cài ứng dụng, chỉ cần quét mã bằng camera là gửi được ngay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí na akci ukázat QR kód. Kdo posílá fotky, nemusí instalovat aplikaci: naskenuje QR kamerou a hned posílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal bare vise QR-koden til begivenheden. Gæsterne sender billeder med det samme ved at scanne den med kameraet. De skal ikke installere en app."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκεί να δείξετε το QR στην εκδήλωση. Όποιος στέλνει φωτογραφίες δεν χρειάζεται να εγκαταστήσει εφαρμογή: σαρώνει το QR με την κάμερα και στέλνει αμέσως."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä vain QR-koodi tilaisuudessa. Kuvien lähettäjän ei tarvitse asentaa sovellusta: hän skannaa koodin kameralla ja lähettää heti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup tampilkan QR di acaramu. Pengirim tidak perlu memasang app, cukup pindai QR dengan kamera dan langsung kirim."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger bare å vise QR-koden på arrangementet. Gjestene skanner den med kameraet og sender bilder med en gang, uten å installere noen app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat gewoon de QR-code zien op je evenement. Gasten sturen meteen foto's door de code met de camera te scannen, zonder een app te installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystarczy pokazać kod QR na wydarzeniu. Osoby wysyłające zdjęcia nie muszą instalować aplikacji. Skanują kod aparatem i od razu wysyłają."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa bara QR-koden på ditt event. Den som skickar bilder behöver ingen app, utan skannar koden med kameran och skickar direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinlikte QR kodu göstermeniz yeterli. Fotoğraf gönderenlerin uygulama yüklemesi gerekmez; kamerayla QR'ı okutup hemen gönderebilir."
          }
        }
      }
    },
    "호스트 iPhone에 연결하지 못했어요. 같은 Wi-Fi인지, 로컬 네트워크 권한을 허용했는지 확인해 주세요.%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the host's iPhone. Check that you're on the same Wi-Fi and that Local Network access is allowed.%@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the host's iPhone. Check that you're on the same Wi-Fi and that Local Network access is switched on.%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到接收方的 iPhone。请确认已连接同一 Wi-Fi，并已允许访问本地网络。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到接收方的 iPhone。請確認已連接同一個 Wi-Fi，並已允許存取區域網路。%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストのiPhoneに接続できませんでした。同じWi-Fiに接続しているか、ローカルネットワークへのアクセスを許可しているか確認してください。%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к iPhone организатора. Проверьте, что вы в той же сети Wi-Fi и что доступ к локальной сети разрешён.%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el iPhone del anfitrión. Comprueba que estás en la misma red Wi-Fi y que se ha permitido el acceso a la red local.%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zum iPhone des Gastgebers fehlgeschlagen. Prüfe, ob du im selben WLAN bist und der Zugriff auf das lokale Netzwerk erlaubt ist.%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre l’iPhone de l’hôte. Vérifiez que vous êtes sur le même Wi-Fi et que l’accès au réseau local est autorisé.%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile collegarsi all'iPhone dell'host. Controlla di essere sullo stesso Wi-Fi e di aver consentito l'accesso alla rete locale.%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao iPhone do anfitrião. Verifique se vocês estão no mesmo Wi-Fi e se o acesso à Rede Local está permitido.%@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับ iPhone ของเจ้าของอีเวนต์ไม่ได้ ตรวจสอบว่าใช้ Wi-Fi เดียวกัน และอนุญาตการเข้าถึงเครือข่ายภายในแล้ว%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được với iPhone của chủ sự kiện. Hãy kiểm tra xem hai máy có cùng Wi-Fi không và đã cho phép truy cập mạng cục bộ chưa.%@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit s iPhonem hostitele. Zkontrolujte, že jste ve stejné Wi-Fi a že máte povolený přístup k místní síti.%@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få forbindelse til værtens iPhone. Tjek, at I er på samme Wi-Fi, og at adgang til lokalt netværk er slået til.%@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με το iPhone του διοργανωτή. Ελέγξτε ότι είστε στο ίδιο Wi-Fi και ότι επιτρέπεται η πρόσβαση στο τοπικό δίκτυο.%@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyttä isännän iPhoneen ei saatu. Tarkista, että olet samassa Wi-Fi-verkossa ja että paikallisen verkon käyttö on sallittu.%@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa terhubung ke iPhone host. Pastikan di Wi-Fi yang sama dan akses Jaringan Lokal sudah diizinkan.%@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikk ikke kontakt med vertens iPhone. Sjekk at dere er på samme Wi-Fi og at tilgang til lokalt nettverk er tillatt.%@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon geen verbinding maken met de iPhone van de host. Controleer of je op hetzelfde wifi-netwerk zit en of toegang tot het lokale netwerk is toegestaan.%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z iPhonem organizatora. Sprawdź, czy jesteście w tej samej sieci Wi-Fi i czy zezwolono na dostęp do sieci lokalnej.%@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå värdens iPhone. Kontrollera att ni är på samma Wi-Fi och att åtkomst till lokalt nätverk är tillåten.%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alıcının iPhone'una bağlanılamadı. Aynı Wi-Fi ağında olduğunuzdan ve Yerel Ağ erişimine izin verildiğinden emin olun.%@"
          }
        }
      }
    },
