          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz do mojego wspólnego albumu w Botaejwo. Otwórz link i od razu zbieramy zdjęcia razem."
          }
        },
        "sv" : {
          "stringUnit" : {
