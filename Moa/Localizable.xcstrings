          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te invito a mi álbum compartido de Botaejwo. Abre el enlace y juntamos las fotos al momento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm in mein geteiltes Botaejwo‑Album. Öffne den Link, dann sammeln wir die Fotos gleich zusammen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoins mon album partagé Botaejwo. Ouvre le lien et on rassemble nos photos tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unisciti al mio album condiviso su Botaejwo. Apri il link e raccogliamo subito le foto insieme."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
