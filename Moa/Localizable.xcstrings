    "같은 %@에서 QR을 찍으면 이 iPhone으로 바로 와요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan on the same %@ to send straight to this iPhone"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan on the same %@ to send straight to this iPhone"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相同%@下扫描二维码，照片会直接传到这台 iPhone"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相同%@下掃描 QR Code，照片會直接傳到這部 iPhone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ%@でQRを読み取ると、このiPhoneにすぐ届きます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото придут сразу на этот iPhone, если отсканировать QR-код в той же сети (%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el QR con la misma conexión (%@) y las fotos llegarán directas a este iPhone"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den QR-Code über dieselbe Verbindung (%@), dann kommt alles direkt auf dieses iPhone"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le QR code sur le même %@ et les photos arrivent directement sur cet iPhone"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stessa connessione (%@): inquadra il QR e le foto arrivano subito su questo iPhone"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mesma %@, basta escanear o QR para as fotos chegarem direto a este iPhone"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สแกน QR ใน%@เดียวกัน รูปจะส่งตรงมาที่ iPhone เครื่องนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét mã QR trên cùng một %@ là ảnh gửi thẳng đến iPhone này"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte QR ve stejném připojení (%@) a fotky půjdou rovnou na tento iPhone"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan QR-koden på samme %@, så sendes billederne direkte til denne iPhone"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε το QR στο ίδιο %@ και οι φωτογραφίες έρχονται απευθείας σε αυτό το iPhone"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa QR-koodi samalla yhteydellä (%@), niin kuvat tulevat suoraan tähän iPhoneen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai QR di %@ untuk langsung mengirim ke iPhone ini"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skann QR-koden på %@ for å sende rett til denne iPhonen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de QR-code via %@ om direct naar deze iPhone te sturen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj QR przez to samo połączenie (%@), a zdjęcia trafią prosto na ten iPhone"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna QR-koden via samma anslutning (%@) så skickas bilderna direkt till den här iPhonen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı %@ üzerinden QR'ı okutursanız fotoğraflar doğrudan bu iPhone'a gelir"
          }
        }
      }
