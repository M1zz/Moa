            "value" : "Κρατήστε την οθόνη αναμμένη μέχρι να σταλούν όλα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä näyttö päällä, kunnes kaikki on lähetetty."
          }
        },
        "id" : {
          "stringUnit" : {
