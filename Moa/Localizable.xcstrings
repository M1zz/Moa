    "가까이 있으면 인터넷 없이도 바로 보내요. 두 기기 모두 Wi-Fi만 켜 두세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nearby, photos go straight across, no internet needed. Just keep Wi-Fi on on both phones."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nearby, photos go straight across, no internet needed. Just keep Wi-Fi on on both phones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距离较近时无需联网即可直接发送。两台设备都打开 Wi-Fi 即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離較近時不必連網即可直接傳送。兩台裝置都開啟 Wi-Fi 即可。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くにいれば、インターネットなしでそのまま送れます。両方の端末でWi-Fiをオンにしておいてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядом фото уходят напрямую, без интернета. Просто держите Wi-Fi включённым на обоих телефонах."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si estás cerca, las fotos se envían directamente, sin internet. Solo deja la Wi-Fi activada en ambos teléfonos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Nähe gehen Fotos direkt rüber, ganz ohne Internet. Lass einfach auf beiden Geräten WLAN an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À proximité, les photos passent directement, sans Internet. Gardez simplement le Wi-Fi activé sur les deux appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se siete vicini, le foto passano direttamente, senza internet. Basta tenere attivo il Wi-Fi su entrambi i telefoni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiverem perto, as fotos vão direto, sem internet. Só deixe o Wi-Fi ligado nos dois aparelhos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าอยู่ใกล้กัน รูปจะส่งตรงถึงกันโดยไม่ต้องใช้อินเทอร์เน็ต แค่เปิด Wi-Fi ไว้ทั้งสองเครื่อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ở gần, ảnh được gửi thẳng mà không cần internet. Chỉ cần bật Wi-Fi trên cả hai điện thoại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na blízko jdou fotky přímo, bez internetu. Stačí mít na obou telefonech zapnutou Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæt på sendes billederne direkte uden internet. Hav bare wi-fi slået til på begge telefoner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είστε κοντά, οι φωτογραφίες πάνε απευθείας, χωρίς διαδίκτυο. Απλώς αφήστε το Wi-Fi ανοιχτό και στα δύο κινητά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähellä kuvat menevät suoraan ilman internetiä. Pidä vain Wi-Fi päällä molemmissa puhelimissa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau berdekatan, foto langsung terkirim tanpa internet. Cukup nyalakan Wi-Fi di kedua ponsel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nærheten går bildene rett over, uten internett. Bare ha wifi på på begge telefonene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichtbij gaan foto’s direct over, zonder internet. Laat wifi gewoon aan staan op beide toestellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z bliska zdjęcia przechodzą bezpośrednio, bez internetu. Wystarczy włączone Wi-Fi na obu telefonach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nära varandra skickas bilderna direkt, utan internet. Ha bara wifi på i båda telefonerna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakındaysanız fotoğraflar internet olmadan doğrudan gider. İki telefonda da Wi-Fi’ı açık tutmanız yeterli."
          }
        }
      }
    },
