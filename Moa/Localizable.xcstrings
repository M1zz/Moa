    "멀리 있는 사람이 보낸 사진은 iCloud를 거쳐 들어와요." : {
      "comment" : "Appended to onboarding page 3 when remote sending is configured",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos from people who aren't nearby arrive through iCloud."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos from people who aren't nearby arrive via iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远处的人发送的照片会经由 iCloud 传来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠在他方的人傳送的照片會經由 iCloud 傳來。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離れた場所にいる人が送った写真は、iCloud経由で届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото от тех, кто далеко, приходят через iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos de quienes están lejos llegan a través de iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos von Personen, die nicht in der Nähe sind, kommen über iCloud an."
