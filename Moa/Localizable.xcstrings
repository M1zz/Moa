    "보태줘 공유 앨범에 초대해요. 링크를 열면 바로 함께 사진을 모을 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join my shared album on Botaejwo. Open the link and we can gather photos together right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join my shared album on Botaejwo. Open the link and we can gather photos together straight away."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀请你加入 Botaejwo 共享相簿。打开链接就能马上一起收集照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀請你加入 Botaejwo 共享相簿。打開連結就能馬上一起收集照片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
