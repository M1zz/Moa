    "이 화면이 켜져 있는 동안만 받아요. 화면은 자동으로 꺼지지 않아요.\n화면을 다시 열면 QR이 바뀌어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos arrive only while this screen is on. It won't turn off by itself.\nThe QR code changes each time you reopen the screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos arrive only while this screen is on, and it won't switch off by itself.\nThe QR code changes whenever you reopen the screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在此屏幕亮着时接收照片，屏幕不会自动锁定。\n重新打开此屏幕后，二维码会更换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在此畫面開啟時接收照片，螢幕不會自動鎖定。\n重新開啟此畫面後，QR Code 會更換。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面が表示されている間だけ受信します。画面は自動ではスリープしません。\n画面を開き直すとQRが変わります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото приходят, только пока этот экран включён. Он не гаснет сам.\nПри повторном открытии экрана QR-код меняется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos solo llegan mientras esta pantalla está encendida. No se apaga sola.\nAl volver a abrirla, el QR cambia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos kommen nur an, solange dieser Bildschirm eingeschaltet ist. Er schaltet sich nicht von selbst aus.\nBeim erneuten Öffnen ändert sich der QR-Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos n’arrivent que tant que cet écran est allumé. Il ne s’éteint pas tout seul.\nLe QR code change chaque fois que vous rouvrez l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto arrivano solo mentre questa schermata è accesa. Non si spegne da sola.\nIl QR cambia ogni volta che riapri la schermata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos só chegam enquanto esta tela estiver ligada. Ela não apaga sozinha.\nO QR muda toda vez que você reabre a tela."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับรูปได้เฉพาะตอนที่หน้าจอนี้เปิดอยู่ และหน้าจอจะไม่ดับเอง\nQR จะเปลี่ยนทุกครั้งที่เปิดหน้าจอนี้ใหม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ nhận ảnh khi màn hình này đang bật. Màn hình sẽ không tự tắt.\nMã QR đổi mới mỗi khi bạn mở lại màn hình."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky přicházejí, jen dokud je tato obrazovka zapnutá. Samovolně se nevypne.\nPo jejím opětovném otevření se QR kód změní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billeder kommer kun ind, mens denne skærm er tændt. Den slukker ikke af sig selv.\nQR-koden skifter, hver gang du åbner skærmen igen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λήψη γίνεται μόνο όσο αυτή η οθόνη είναι αναμμένη. Δεν σβήνει μόνη της.\nΤο QR αλλάζει κάθε φορά που ανοίγετε ξανά την οθόνη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvat tulevat vain, kun tämä näyttö on päällä. Näyttö ei sammu itsestään.\nQR-koodi vaihtuu aina, kun avaat näytön uudelleen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto hanya diterima selama layar ini menyala. Layar tidak mati otomatis.\nQR berubah setiap kali layar dibuka lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder mottas bare mens denne skjermen er på. Den slår seg ikke av av seg selv.\nQR-koden endres hver gang du åpner skjermen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto's komen alleen binnen zolang dit scherm aan is. Het scherm gaat niet vanzelf uit.\nDe QR-code verandert elke keer dat je het scherm opnieuw opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia docierają tylko wtedy, gdy ten ekran jest włączony. Sam nie zgaśnie.\nPo ponownym otwarciu ekranu kod QR się zmieni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder tas bara emot medan den här skärmen är på. Den släcks inte av sig själv.\nQR-koden byts varje gång du öppnar skärmen igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar yalnızca bu ekran açıkken alınır. Ekran kendiliğinden kapanmaz.\nEkranı yeniden açtığınızda QR kod değişir."
          }
        }
      }
    },
