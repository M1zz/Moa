    "%lld개" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "%lld개 가져왔어요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got %lld"
          }
        }
      }
    },
    "%lld개 실패" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld failed"
          }
        }
      }
    },
    "QR 하나로 사진을 모아요" : {
      "comment" : "Onboarding page 1 title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One QR code gathers the photos"
          }
        }
      }
    },
    "Wi-Fi 또는 개인용 핫스팟에 연결되어 있지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone isn't connected to Wi-Fi or a Personal Hotspot."
          }
        }
      }
    },
    "iCloud 응답을 이해하지 못했어요. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the response from iCloud. %@"
          }
        }
      }
    },
    "iCloud가 요청을 거절했어요 (%lld). %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud turned down the request (%1$lld). %2$@"
          }
        }
      }
    },
    "가져올 파일이 없어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no file to import."
          }
        }
      }
    },
    "같은 %@에서 QR을 찍으면 이 iPhone으로 바로 와요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan on the same %@ to send straight to this iPhone"
          }
        }
      }
    },
    "개인용 핫스팟" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Hotspot"
          }
        }
      }
    },
    "건너뛰기" : {
      "comment" : "Skips the onboarding",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip"
