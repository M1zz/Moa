    "공유 앨범마다 사람을 한 명씩 추가할 필요가 없어요. 링크를 보내거나 QR을 보여주면, 연 사람은 바로 멤버가 돼요. 멤버 누구나 다른 사람을 초대할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more adding people to each shared album one by one. Send the link or show the QR code, and whoever opens it is a member right away. Any member can invite others."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more adding people to each shared album one by one. Send the link or show the QR code, and whoever opens it is a member straight away. Any member can invite others."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用再为每个共享相簿逐个添加成员。发送链接或出示二维码，打开的人马上就是成员。任何成员都能邀请别人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用再為每本共享相簿一個一個加入成員。傳送連結或出示 QR 碼，打開的人馬上就是成員。任何成員都能邀請別人。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有アルバムごとに1人ずつ追加する必要はもうありません。リンクを送るかQRコードを見せれば、開いた人はすぐメンバーです。メンバーなら誰でもほかの人を招待できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше не нужно добавлять людей в каждый общий альбом по одному. Отправьте ссылку или покажите QR-код — кто откроет, сразу станет участником. Приглашать других может любой участник."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvídate de añadir a la gente a cada álbum compartido una por una. Envía el enlace o muestra el código QR y quien lo abra será miembro al instante. Cualquier miembro puede invitar a otros."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schluss damit, Leute einzeln zu jedem geteilten Album hinzuzufügen. Schick den Link oder zeig den QR‑Code – wer ihn öffnet, ist sofort Mitglied. Jedes Mitglied kann weitere einladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fini d’ajouter les gens un par un à chaque album partagé. Envoyez le lien ou montrez le code QR : qui l’ouvre devient membre aussitôt. Chaque membre peut inviter d’autres personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta aggiungere le persone una alla volta a ogni album condiviso. Invia il link o mostra il codice QR: chi lo apre diventa subito membro. Ogni membro può invitare altri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chega de adicionar pessoas uma a uma em cada álbum compartilhado. Envie o link ou mostre o QR code e quem abrir vira membro na hora. Qualquer membro pode convidar outras pessoas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องเพิ่มคนเข้าอัลบั้มที่แชร์ทีละคนอีกต่อไป ส่งลิงก์หรือโชว์ QR ใครเปิดก็เป็นสมาชิกทันที และสมาชิกทุกคนเชิญคนอื่นต่อได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không còn phải thêm từng người vào mỗi album chia sẻ. Gửi liên kết hoặc đưa mã QR, ai mở là thành viên ngay. Thành viên nào cũng có thể mời người khác."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už žádné přidávání lidí do každého sdíleného alba po jednom. Pošlete odkaz nebo ukažte QR kód a kdo ho otevře, je hned členem. Pozvat další může kterýkoli člen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut med at tilføje folk til hvert delt album en ad gangen. Send linket eller vis QR-koden, så er den, der åbner det, straks medlem. Alle medlemmer kan invitere andre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τέλος η προσθήκη ατόμων ένα ένα σε κάθε κοινόχρηστο άλμπουμ. Στείλτε τον σύνδεσμο ή δείξτε τον κωδικό QR και όποιος τον ανοίξει γίνεται αμέσως μέλος. Κάθε μέλος μπορεί να προσκαλέσει άλλους."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihmisiä ei enää tarvitse lisätä jokaiseen jaettuun albumiin yksitellen. Lähetä linkki tai näytä QR-koodi, niin avaaja on heti jäsen. Kuka tahansa jäsen voi kutsua muita."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak perlu lagi menambahkan orang satu per satu ke setiap album bersama. Kirim tautan atau tunjukkan kode QR, siapa pun yang membukanya langsung jadi anggota. Setiap anggota bisa mengundang orang lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutt på å legge folk til i hvert delte album én etter én. Send lenken eller vis QR-koden, så er den som åpner den, medlem med én gang. Alle medlemmer kan invitere andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nooit meer mensen één voor één aan elk gedeeld album toevoegen. Stuur de link of laat de QR-code zien en wie hem opent, is meteen lid. Elk lid kan anderen uitnodigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koniec z dodawaniem osób do każdego wspólnego albumu pojedynczo. Wyślij link lub pokaż kod QR, a kto go otworzy, od razu zostaje członkiem. Każdy członek może zapraszać innych."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slipp att lägga till folk i varje delat album en i taget. Skicka länken eller visa QR-koden, så blir den som öppnar den medlem direkt. Alla medlemmar kan bjuda in fler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık her paylaşılan albüme kişileri tek tek eklemek yok. Bağlantıyı gönderin ya da QR kodunu gösterin; açan kişi hemen üye olur. Her üye başkalarını davet edebilir."
          }
        }
      }
    },
