          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte obrazovku zapnutou, dokud se vše neodešle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad skærmen være tændt, til alt er sendt."
          }
        },
        "el" : {
          "stringUnit" : {
