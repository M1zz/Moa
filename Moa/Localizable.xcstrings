          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอชวนเข้าอัลบั้มที่แชร์ใน Botaejwo เปิดลิงก์แล้วมารวมรูปกันได้เลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mời bạn vào album chia sẻ trên Botaejwo. Mở liên kết là mình cùng gom ảnh ngay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvu tě do sdíleného alba v Botaejwo. Otevři odkaz a můžeme hned dávat fotky dohromady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom med i mit delte album i Botaejwo. Åbn linket, så kan vi samle billederne med det samme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε προσκαλώ στο κοινόχρηστο άλμπουμ μου στο Botaejwo. Άνοιξε τον σύνδεσμο και μαζεύουμε αμέσως τις φωτογραφίες."
          }
        },
        "fi" : {
          "stringUnit" : {
