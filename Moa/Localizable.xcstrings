    "고른 사진과 동영상이 원본 그대로, 찍은 시각 그대로 호스트의 사진 앱에 들어가요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photos and videos you pick go into the host's Photos app as originals, at the time they were taken."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photos and videos you choose go into the host's Photos app as originals, with their original time taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选的照片和视频会保持原画质和拍摄时间，存入接收方的“照片”App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選的照片和影片會維持原畫質與拍攝時間，存入接收方的「照片」App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ写真と動画は、オリジナルのまま撮影時刻も保ったまま、ホストの写真アプリに入ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные фото и видео попадут в «Фото» организатора в оригинале и с исходным временем съёмки."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos y los vídeos que elijas llegan a la app Fotos del anfitrión como originales, con la hora a la que se hicieron."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Fotos und Videos landen als Originale mit ihrem Aufnahmezeitpunkt in der Fotos-App des Gastgebers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos choisies arrivent en originaux, à l’heure de prise de vue, dans l’app Photos de l’hôte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto e i video scelti arrivano nell'app Foto dell'host come originali, con l'ora di scatto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e os vídeos escolhidos vão para o app Fotos do anfitrião como originais, no horário em que foram feitos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปและวิดีโอที่เลือกจะเข้าแอปรูปภาพของเจ้าของอีเวนต์เป็นไฟล์ต้นฉบับ ตรงตามเวลาที่ถ่าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh và video đã chọn vào ứng dụng Ảnh của chủ sự kiện dưới dạng bản gốc, đúng thời điểm chụp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané fotky a videa se uloží do Fotek hostitele jako originály, s časem pořízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De billeder og videoer, du vælger, lægges som originaler i værtens Fotos med det tidspunkt, de blev taget."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες και τα βίντεο που επιλέγετε μπαίνουν στις Φωτογραφίες του διοργανωτή ως πρωτότυπα, στη στιγμή της λήψης."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemasi kuvat ja videot siirtyvät isännän Kuvat-appiin alkuperäisinä ottohetkensä mukaan."
          }
        },
        "id" : {
          "stringUnit" : {
