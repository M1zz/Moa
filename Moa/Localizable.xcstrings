    },
    "%@ 님이 보낸 사진을 넣었어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added a photo from %@."
          }
        }
      }
    },
    "%@ 님이 보냈어요" : {
