          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i det delte albumet mitt i Botaejwo. Åpne lenken, så samler vi bildene med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
