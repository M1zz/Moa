    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends your photos straight to the host's iPhone on the same Wi-Fi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Wi-Fi에 있는 호스트의 iPhone으로 사진을 바로 보내기 위해 필요해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends your photos directly to the host's iPhone on the same Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于将照片直接发送到同一 Wi-Fi 下接收方的 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將照片直接傳送到同一個 Wi-Fi 下接收方的 iPhone。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じWi-FiにいるホストのiPhoneに写真を直接送るために必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы отправлять фото напрямую на iPhone организатора в той же сети Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tus fotos directamente al iPhone del anfitrión en la misma red Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet deine Fotos direkt an das iPhone des Gastgebers im selben WLAN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie vos photos directement à l’iPhone de l’hôte sur le même Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per inviare le foto direttamente all'iPhone dell'host sullo stesso Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para enviar as fotos direto ao iPhone do anfitrião no mesmo Wi-Fi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อส่งรูปตรงไปยัง iPhone ของเจ้าของอีเวนต์ที่อยู่ใน Wi-Fi เดียวกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần để gửi ảnh thẳng đến iPhone của chủ sự kiện dùng chung Wi-Fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošle vaše fotky přímo na iPhone hostitele ve stejné Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sender dine billeder direkte til værtens iPhone på samme Wi-Fi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέλνει τις φωτογραφίες σας απευθείας στο iPhone του διοργανωτή στο ίδιο Wi-Fi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähettää kuvasi suoraan isännän iPhoneen samassa Wi-Fi-verkossa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengirim foto langsung ke iPhone host di Wi-Fi yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sender bildene dine rett til vertens iPhone på samme Wi-Fi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuurt je foto's rechtstreeks naar de iPhone van de host op hetzelfde wifi-netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła zdjęcia prosto na iPhone organizatora w tej samej sieci Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickar dina bilder direkt till värdens iPhone på samma Wi-Fi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflarınızı aynı Wi-Fi ağındaki alıcının iPhone'una doğrudan göndermek için gerekli."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
