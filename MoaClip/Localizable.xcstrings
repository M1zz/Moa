        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งครบแล้ว ขอบคุณ! เนื่องจากอยู่ไม่ใกล้กัน จึงส่งผ่าน iCloud และรูปจะเข้าแอปรูปภาพเมื่อเจ้าของอีเวนต์เปิดแอป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã gửi hết. Cảm ơn bạn! Vì không ở gần nhau nên ảnh đi qua iCloud và sẽ vào Ảnh khi chủ sự kiện mở ứng dụng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše odesláno. Děkujeme! Nebyli jste poblíž, proto to šlo přes iCloud a do Fotek se to dostane, až hostitel otevře aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er sendt. Tak! Du var ikke i nærheden, så det gik via iCloud og lander i Fotos, når værten åbner appen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στάλθηκαν όλα. Ευχαριστούμε! Δεν ήσασταν κοντά, γι' αυτό πέρασαν από το iCloud και θα μπουν στις Φωτογραφίες όταν ο διοργανωτής ανοίξει την εφαρμογή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki lähetetty. Kiitos! Et ollut lähellä, joten kuvat kulkivat iCloudin kautta ja siirtyvät Kuvat-appiin, kun isäntä avaa sovelluksen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua terkirim. Terima kasih! Karena tidak berdekatan, file dikirim lewat iCloud dan akan masuk ke Foto saat host membuka app."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er sendt. Takk! Du var ikke i nærheten, så det gikk via iCloud og havner i Bilder når verten åpner appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles verstuurd. Bedankt! Je was niet in de buurt, dus het ging via iCloud en komt in Foto's zodra de host de app opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko wysłane. Dziękujemy! Organizator był daleko, więc zdjęcia poszły przez iCloud i trafią do aplikacji Zdjęcia, gdy otworzy on aplikację."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt är skickat. Tack! Du var inte i närheten, så det gick via iCloud och hamnar i Bilder när värden öppnar appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hepsi gönderildi. Teşekkürler! Yakında olmadığınız için iCloud üzerinden iletildi; alıcı uygulamayı açınca Fotoğraflar'a girecek."
          }
        }
      }
    },
