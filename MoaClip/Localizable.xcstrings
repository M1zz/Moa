    "호스트 iPhone에 연결하지 못했어요. 같은 Wi-Fi인지, 로컬 네트워크 권한을 허용했는지 확인해 주세요.%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the host's iPhone. Check that you're on the same Wi-Fi and that Local Network access is allowed.%@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the host's iPhone. Check that you're on the same Wi-Fi and that Local Network access is switched on.%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到接收方的 iPhone。请确认已连接同一 Wi-Fi，并已允许访问本地网络。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到接收方的 iPhone。請確認已連接同一個 Wi-Fi，並已允許存取區域網路。%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストのiPhoneに接続できませんでした。同じWi-Fiに接続しているか、ローカルネットワークへのアクセスを許可しているか確認してください。%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к iPhone организатора. Проверьте, что вы в той же сети Wi-Fi и что доступ к локальной сети разрешён.%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el iPhone del anfitrión. Comprueba que estás en la misma red Wi-Fi y que se ha permitido el acceso a la red local.%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zum iPhone des Gastgebers fehlgeschlagen. Prüfe, ob du im selben WLAN bist und der Zugriff auf das lokale Netzwerk erlaubt ist.%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre l’iPhone de l’hôte. Vérifiez que vous êtes sur le même Wi-Fi et que l’accès au réseau local est autorisé.%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile collegarsi all'iPhone dell'host. Controlla di essere sullo stesso Wi-Fi e di aver consentito l'accesso alla rete locale.%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao iPhone do anfitrião. Verifique se vocês estão no mesmo Wi-Fi e se o acesso à Rede Local está permitido.%@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับ iPhone ของเจ้าของอีเวนต์ไม่ได้ ตรวจสอบว่าใช้ Wi-Fi เดียวกัน และอนุญาตการเข้าถึงเครือข่ายภายในแล้ว%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được với iPhone của chủ sự kiện. Hãy kiểm tra xem hai máy có cùng Wi-Fi không và đã cho phép truy cập mạng cục bộ chưa.%@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit s iPhonem hostitele. Zkontrolujte, že jste ve stejné Wi-Fi a že máte povolený přístup k místní síti.%@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få forbindelse til værtens iPhone. Tjek, at I er på samme Wi-Fi, og at adgang til lokalt netværk er slået til.%@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με το iPhone του διοργανωτή. Ελέγξτε ότι είστε στο ίδιο Wi-Fi και ότι επιτρέπεται η πρόσβαση στο τοπικό δίκτυο.%@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyttä isännän iPhoneen ei saatu. Tarkista, että olet samassa Wi-Fi-verkossa ja että paikallisen verkon käyttö on sallittu.%@"
          }
        },
