    "사진을 고르면 원본 그대로 받는 사람의 사진 앱에 들어가요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick photos, and the originals go into their Photos app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your photos and the originals go straight into their Photos app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选好照片后，原图会直接存入接收方的“照片”App。"
