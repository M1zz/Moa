    "%lldMB라서 멀리 있는 호스트에게는 보낼 수 없어요. 같은 Wi-Fi에서 보내 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At %lld MB, this is too large to send to a host who isn't nearby. Send it on the same Wi-Fi."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At %lld MB, this is too large to send to a host who isn't nearby. Please send it on the same Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld MB 的文件太大，无法发送给远处的接收方。请连接同一 Wi-Fi 后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld MB 的檔案太大，無法傳送給遠端的接收方。請連接同一個 Wi-Fi 後傳送。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldMBあるため、離れたホストには送れません。同じWi-Fiで送ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл весит %lld МБ — слишком много, чтобы отправить его организатору, который не рядом. Отправьте его из той же сети Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %lld MB es demasiado grande para enviarlo a un anfitrión que no está cerca. Envíalo desde la misma red Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %lld MB ist die Datei zu groß, um sie an einen Gastgeber in der Ferne zu senden. Sende sie im selben WLAN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %lld Mo, ce fichier est trop volumineux pour être envoyé à un hôte éloigné. Envoyez-le depuis le même Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %lld MB è troppo grande per essere inviato a un host lontano. Invialo dallo stesso Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %lld MB, é grande demais para enviar a um anfitrião que está longe. Envie pelo mesmo Wi-Fi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ขนาด %lld MB ใหญ่เกินกว่าจะส่งให้เจ้าของอีเวนต์ที่อยู่ไกลได้ กรุณาส่งผ่าน Wi-Fi เดียวกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp %lld MB quá lớn để gửi cho chủ sự kiện ở xa. Hãy gửi khi dùng chung Wi-Fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při velikosti %lld MB to nejde poslat hostiteli, který není poblíž. Pošlete to ve stejné Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med %lld MB er den for stor til at sende til en vært, der ikke er i nærheden. Send den på samme Wi-Fi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με %lld MB, το αρχείο είναι πολύ μεγάλο για αποστολή σε διοργανωτή που δεν βρίσκεται κοντά. Στείλτε το στο ίδιο Wi-Fi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koska koko on %lld Mt, sitä ei voi lähettää kaukana olevalle isännälle. Lähetä se samassa Wi-Fi-verkossa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuran %lld MB terlalu besar untuk dikirim ke host yang jauh. Kirim lewat Wi-Fi yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På %lld MB er filen for stor til å sendes til en vert som ikke er i nærheten. Send den på samme Wi-Fi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met %lld MB is dit te groot om naar een host te sturen die niet in de buurt is. Verstuur het via hetzelfde wifi-netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik ma %lld MB, więc nie można go wysłać organizatorowi, który jest daleko. Wyślij go w tej samej sieci Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen är %lld MB och för stor för att skickas till en värd som inte är i närheten. Skicka den via samma Wi-Fi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld MB olduğu için yakında olmayan bir alıcıya gönderilemez. Aynı Wi-Fi ağında gönderin."
          }
        }
      }
    },
