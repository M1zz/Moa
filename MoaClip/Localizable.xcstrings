        }
      }
    },
    "사진을 받을 사람의 iPhone에 뜬 QR을 카메라로 찍으면, 여기서 바로 사진을 보낼 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the QR code on the collector's iPhone with your camera, and you can send photos right from here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the QR code on the collector's iPhone with your camera and you can send photos straight from here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用相机扫描接收照片者 iPhone 上显示的二维码，就能在这里直接发送照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用相機掃描接收照片者 iPhone 上顯示的 QR Code，就能在這裡直接傳送照片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を受け取る人のiPhoneに表示されたQRをカメラで読み取ると、ここからすぐに写真を送れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте камерой QR-код на iPhone того, кто собирает фото, и сможете отправлять снимки прямо отсюда."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea con la cámara el QR del iPhone de quien recoge las fotos y podrás enviarlas desde aquí mismo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne mit der Kamera den QR-Code auf dem iPhone der Person, die die Fotos sammelt, dann kannst du direkt von hier senden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez avec l’appareil photo le QR code affiché sur l’iPhone de la personne qui collecte, et vous pourrez envoyer vos photos d’ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra con la fotocamera il QR mostrato sull'iPhone di chi raccoglie le foto e potrai inviarle subito da qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie com a câmera o QR que aparece no iPhone de quem está reunindo as fotos e envie daqui mesmo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สแกน QR ที่แสดงบน iPhone ของผู้รวบรวมรูปด้วยกล้อง แล้วส่งรูปได้จากตรงนี้ทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng camera quét mã QR trên iPhone của người gom ảnh là bạn có thể gửi ảnh ngay tại đây."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte kamerou QR kód na iPhonu toho, kdo fotky sbírá, a můžete odsud rovnou posílat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan QR-koden på modtagerens iPhone med kameraet, så kan du sende billeder herfra."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε με την κάμερα το QR στο iPhone αυτού που μαζεύει τις φωτογραφίες και στείλτε από εδώ απευθείας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa kameralla kuvia keräävän iPhonessa näkyvä QR-koodi, niin voit lähettää kuvia suoraan täältä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai QR di iPhone penerima dengan kamera, lalu kirim foto langsung dari sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skann QR-koden på innsamlerens iPhone med kameraet, så kan du sende bilder rett herfra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de QR-code op de iPhone van de verzamelaar met je camera, dan kun je meteen vanaf hier foto's versturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj aparatem kod QR na iPhonie osoby zbierającej zdjęcia, a wyślesz je stąd od razu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna QR-koden på iPhonen hos den som samlar bilderna med kameran, så kan du skicka bilder direkt härifrån."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğrafları toplayan kişinin iPhone'undaki QR kodu kamerayla okutun, buradan hemen fotoğraf gönderebilirsiniz."
          }
        }
      }
    },
